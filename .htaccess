DirectoryIndex index.html admin.html instructor.html rev.html

# Fallback error documents so server-level 404s route back into the SPA
ErrorDocument 404 /index.html

<FilesMatch "\.(js|mjs)$">
  ForceType application/javascript
</FilesMatch>
<FilesMatch "\.css$">
  ForceType text/css
</FilesMatch>

<IfModule mod_headers.c>
  # Apply dynamic CORS headers to static assets, media files, and uploads
  SetEnvIfNoCase Origin "(.+)" CORS_ORIGIN=$1
  Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
  Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-User-Id, X-User-Email, Accept, Origin, Content-Range, Range"
  Header always set Access-Control-Expose-Headers "Content-Length, Content-Range, Range, Accept-Ranges"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # =========================================================================
  # 1. ALLOW EXISTING PHYSICAL FILES AND DIRECTORIES TO PASS THROUGH IMMEDIATELY
  # =========================================================================
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # =========================================================================
  # 2. DO NOT REWRITE ROOT ASSETS/APIS FOR SUBDOMAINS (BYPASS SUBDOMAIN REWRITE)
  # If a subdomain requests /api/, /uploads/, /assets/, /logo/, or static files that exist at root
  # =========================================================================
  RewriteCond %{HTTP_HOST} ^(instructor|en|admin|rev|reviewer|review|coursereviewer)\.uqlearn\.org [NC]
  RewriteCond %{REQUEST_URI} ^/(api|uploads|assets|logo|favicon\.ico|card\.png|apple-touch-icon\.png)/ [OR]
  RewriteCond %{REQUEST_URI} ^/(a08f7503225e|deploy|get-default-thumbnail)\.php [NC]
  RewriteRule ^ - [L]

  # =========================================================================
  # 3. INTERCEPT MISSING STATIC ASSETS (PREVENTS MIME MISMATCH / CORB)
  # =========================================================================
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot|json|map)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # =========================================================================
  # 4. SUBDOMAIN TO SUBFOLDER REWRITES
  # =========================================================================
  # instructor.uqlearn.org -> /instructor/
  RewriteCond %{HTTP_HOST} ^instructor\.uqlearn\.org [NC]
  RewriteCond %{REQUEST_URI} !^/instructor/
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{REQUEST_URI} !^/uploads/ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/logo/ [NC]
  RewriteRule ^(.*)$ instructor/$1 [L]

  # (en|admin).uqlearn.org -> /admin/
  RewriteCond %{HTTP_HOST} ^(en|admin)\.uqlearn\.org [NC]
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{REQUEST_URI} !^/uploads/ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/logo/ [NC]
  RewriteRule ^(.*)$ admin/$1 [L]

  # (rev|reviewer|...).uqlearn.org -> /rev/
  RewriteCond %{HTTP_HOST} ^(rev|reviewer|review|coursereviewer)\.uqlearn\.org [NC]
  RewriteCond %{REQUEST_URI} !^/rev/
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{REQUEST_URI} !^/uploads/ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/logo/ [NC]
  RewriteRule ^(.*)$ rev/$1 [L]

  # =========================================================================
  # 5. API NORMALIZATION & DIRECT HANDLING
  # =========================================================================
  RewriteRule ^(?:instructor/|admin/|rev/)?api/proxy/v1/(.*)$ api/v1/$1 [QSA,L]
  RewriteRule ^(?:instructor/|admin/|rev/)?api/v1/(.*)$ api/v1/$1 [QSA]

  RewriteRule ^api/v1/study-plan\.php$ api/v1/study-planner.php [QSA,L]
  RewriteRule ^api/v1/onboarding\.php$ api/v1/instructor-onboarding.php [QSA,L]
  RewriteRule ^api/v1/modules\.php$ api/v1/course-modules.php [QSA,L]
  RewriteRule ^api/v1/messages\.php$ api/v1/instructor-messages.php [QSA,L]
  RewriteRule ^api/v1/reviewer-assignments\.php$ api/v1/reviewers.php [QSA,L]
  RewriteRule ^api/v1/courses/([a-zA-Z0-9_\-]+)/?$ api/v1/courses.php?id=$1 [QSA,L]

  RewriteCond %{DOCUMENT_ROOT}/api/v1/$1.php -f
  RewriteRule ^api/v1/(.+?)/?$ api/v1/$1.php [QSA,L]

  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # =========================================================================
  # 6. SPA FALLBACK FOR SUBDOMAINS
  # =========================================================================
  RewriteCond %{HTTP_HOST} ^instructor\.uqlearn\.org [NC]
  RewriteRule ^ instructor/instructor.html [L]

  RewriteCond %{HTTP_HOST} ^(en|admin)\.uqlearn\.org [NC]
  RewriteRule ^ admin/admin.html [L]

  RewriteCond %{HTTP_HOST} ^(rev|reviewer|review|coursereviewer)\.uqlearn\.org [NC]
  RewriteRule ^ rev/rev.html [L]

  # =========================================================================
  # 7. MAIN DOMAIN SPA FALLBACK
  # =========================================================================
  RewriteCond %{REQUEST_URI} !^/uploads/ [NC]
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteRule ^ index.html [L]
</IfModule>